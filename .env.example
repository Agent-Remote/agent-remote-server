AGENT_REMOTE_ENV=development
AGENT_REMOTE_SECRET_KEY=change-me-in-production
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://agent_remote:agent_remote@localhost:5432/agent_remote
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
PORT_FORWARDING_ENABLED=true
PORT_FORWARD_MIN_PORT=1024
PORT_FORWARD_MAX_PORT=65535
PORT_FORWARD_MAX_PER_USER=10
PORT_FORWARD_MAX_PER_DEVICE=10
PORT_FORWARD_MAX_PER_SESSION=5
PORT_FORWARD_MAX_STREAMS=128
PORT_FORWARD_DEFAULT_TTL_SECONDS=28800
PORT_FORWARD_MAX_TTL_SECONDS=86400
PORT_FORWARD_CONNECTION_TOKEN_TTL_SECONDS=60
PORT_FORWARD_LEASE_SECONDS=60
PORT_FORWARD_CONTROL_PLANE_GRACE_SECONDS=300
PORT_FORWARD_BYTES_PER_SECOND=0
PORT_FORWARD_CLEANUP_INTERVAL_SECONDS=30
PORT_FORWARD_CREATE_RATE_LIMIT_PER_MINUTE=30
PORT_FORWARD_REDEEM_RATE_LIMIT_PER_MINUTE=120
DEVICE_CONTROL_ENABLED=false
DEVICE_CONTROL_V2_ENABLED=true
DEVICE_SESSION_AUTHORIZATION_MODE=per_application_approval
DEVICE_CONTROL_RELEASE_EVIDENCE_PATH=
DEVICE_CONTROL_RELEASE_PUBLIC_KEY=
DEVICE_SESSION_RETENTION_DAYS=0
DEVICE_SESSION_AUDIT_RETENTION_DAYS=0
